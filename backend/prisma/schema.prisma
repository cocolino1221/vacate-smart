generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  HOTEL
  FLIGHT
  TRANSFER
  RAIL
}

enum OrderStatus {
  PENDING_PAYMENT // creată, așteaptă plata
  PAID            // plătită, se rezervă la furnizor
  CONFIRMED       // toate produsele confirmate de RateHawk
  PARTIALLY_FAILED
  FAILED          // rezervarea a eșuat (se rambursează)
  CANCELLED
  REFUNDED
  EXPIRED
}

enum ItemStatus {
  PENDING
  BOOKING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Order {
  id                String      @id @default(cuid())
  partnerOrderId    String      @unique
  accessToken       String
  status            OrderStatus @default(PENDING_PAYMENT)
  currency          String
  netAmount         Decimal     @db.Decimal(12, 2)
  sellAmount        Decimal     @db.Decimal(12, 2)
  customerEmail     String
  customerPhone     String
  customerFirstName String
  customerLastName  String
  customerComment   String?
  language          String      @default("ro")
  userIp            String?
  items             OrderItem[]
  payments          Payment[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        ProductType
  status         ItemStatus  @default(PENDING)
  // identificatori la furnizor (RateHawk)
  supplierRef    String?     // partner_order_id trimis la RateHawk
  supplierOrderId String?    // order_id primit de la RateHawk
  supplierItemId String?
  bookHash       String?
  paymentType    String?     // ex. "deposit"
  netAmount      Decimal     @db.Decimal(12, 2)
  sellAmount     Decimal     @db.Decimal(12, 2)
  currency       String
  // date afișate clientului: hotel, cameră, date, politică anulare etc.
  details        Json
  // oaspeți / pasageri
  travellers     Json
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String        // stripe | test
  providerRef String        @unique
  amount      Decimal       @db.Decimal(12, 2)
  currency    String
  status      PaymentStatus @default(PENDING)
  raw         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Date statice hoteluri (din /hotel/info/ sau din dump-ul RateHawk)
model Hotel {
  hid        Int      @id
  id         String   @unique
  name       String
  starRating Int      @default(0)
  regionId   Int?
  countryCode String?
  latitude   Float?
  longitude  Float?
  data       Json
  updatedAt  DateTime @updatedAt

  @@index([regionId])
}

// Adaos comercial pe produs (se poate schimba din admin)
model MarkupRule {
  id        String      @id @default(cuid())
  product   ProductType @unique
  percent   Decimal     @db.Decimal(5, 2)
  fixed     Decimal     @default(0) @db.Decimal(10, 2)
  updatedAt DateTime    @updatedAt
}
