# ===== Copiați în .env și completați. NU puneți .env în git. =====
NODE_ENV=production
PUBLIC_URL=https://vacatesmart.ro
POSTGRES_PASSWORD=schimbati-parola-asta

# --- RateHawk (ETG API v3) ---
# Cheile de test (sandbox) și cele de producție le primiți de la account managerul RateHawk.
RATEHAWK_BASE_URL=https://api.worldota.net/api/b2b/v3
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_DEFAULT_RESIDENCY=ro

DEFAULT_CURRENCY=EUR
DEFAULT_LANGUAGE=ro

# --- Adaos comercial implicit (%) – se poate schimba și din API-ul de admin ---
MARKUP_HOTEL_PERCENT=10
MARKUP_FLIGHT_PERCENT=3
MARKUP_TRANSFER_PERCENT=12
MARKUP_RAIL_PERCENT=5

# --- Plăți ---
# stripe = producție;  test = plată simulată (DOAR pentru sandbox, interzis cu NODE_ENV=production)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vacate Smart <rezervari@vacatesmart.ro>
ADMIN_EMAIL=

# --- Admin API: token lung și aleator (ex.: openssl rand -hex 32) ---
ADMIN_TOKEN=
